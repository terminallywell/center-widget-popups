<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>CenterWidgetPopupsConfigForm</class>
    <widget class="QWidget" name="CenterWidgetPopupsConfigForm">
        <layout class="QVBoxLayout" name="layout_main">
            <item>
                <widget class="QLabel" name="label_help">
                    <property name="text">
                        <string>Widget popups whose horizontal center falls within this range of the screen width are moved to the center of the screen. Popups outside it are left alone.</string>
                    </property>
                    <property name="wordWrap">
                        <bool>true</bool>
                    </property>
                </widget>
            </item>
            <item>
                <layout class="QFormLayout" name="layout_form">
                    <item row="0" column="0">
                        <widget class="QLabel" name="label_start">
                            <property name="text">
                                <string>Range starts at:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QSpinBox" name="kcfg_rangeStart">
                            <property name="suffix">
                                <string>% from left edge</string>
                            </property>
                            <property name="minimum">
                                <number>0</number>
                            </property>
                            <property name="maximum">
                                <number>100</number>
                            </property>
                        </widget>
                    </item>
                    <item row="1" column="0">
                        <widget class="QLabel" name="label_end">
                            <property name="text">
                                <string>Range ends at:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="1" column="1">
                        <widget class="QSpinBox" name="kcfg_rangeEnd">
                            <property name="suffix">
                                <string>% from left edge</string>
                            </property>
                            <property name="minimum">
                                <number>0</number>
                            </property>
                            <property name="maximum">
                                <number>100</number>
                            </property>
                        </widget>
                    </item>
                </layout>
            </item>
            <item>
                <widget class="QLabel" name="label_apply">
                    <property name="text">
                        <string>To make changes take effect, disable and re-enable this script in KWin Scripts.</string>
                    </property>
                    <property name="wordWrap">
                        <bool>true</bool>
                    </property>
                    <property name="textInteractionFlags">
                        <set>Qt::TextSelectableByMouse</set>
                    </property>
                </widget>
            </item>
            <item>
                <spacer name="spacer">
                    <property name="orientation">
                        <enum>Qt::Vertical</enum>
                    </property>
                </spacer>
            </item>
        </layout>
    </widget>
</ui>
